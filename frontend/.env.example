# Environment Variables for Web Bluetooth and WiFi Setup Application
# Copy this file to .env.local for local development

# Bluetooth configuration
BLUETOOTH_SERVICE_UUID=032480923873508723857

# WiFi Characteristic UUIDs - Replace with your actual UUIDs
NEXT_PUBLIC_WIFI_CONFIG_CHARACTERISTIC_UUID=00002a19-0000-1000-8000-00805f9b34fb

# Application settings
NEXT_PUBLIC_APP_NAME=Flashlight
NEXT_PUBLIC_DEVICE_NAME_PREFIX=ESP32

# Optional: Connection settings
NEXT_PUBLIC_CONNECTION_TIMEOUT_MS=10000